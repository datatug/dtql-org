{
  // Cloudflare Workers static assets, assets-only: NO Worker script. Every request
  // is answered by static assets (free, never billed against the Workers request quota).
  // Docs: https://developers.cloudflare.com/workers/static-assets/
  "name": "tugql-org",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    // Serve index.html, return its 404 page otherwise.
    "not_found_handling": "404-page",
    // Redirect /index.html and trailing-slash variants to clean URLs.
    "html_handling": "auto-trailing-slash"
  },
  // All four hosts stay attached as Custom Domains (Cloudflare keeps their proxied DNS).
  // Host-level 301s are zone Redirect Rules, evaluated at the edge BEFORE this
  // deployment, so they cost no Worker request:
  //   dtql.org/*, www.dtql.org/* -> https://tugql.org/<path>?<query>   (zone dtql.org)
  //   www.tugql.org/*            -> https://tugql.org/<path>?<query>   (zone tugql.org)
  "routes": [
    { "pattern": "tugql.org", "custom_domain": true },
    { "pattern": "www.tugql.org", "custom_domain": true },
    { "pattern": "dtql.org", "custom_domain": true },
    { "pattern": "www.dtql.org", "custom_domain": true }
  ]
}

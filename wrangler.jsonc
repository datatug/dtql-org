{
  // CloudFlare Workers deployment with static assets and edge redirects.
  // Docs: https://developers.cloudflare.com/workers/static-assets/
  "name": "tugql-org",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    // Serve index.html, return its 404 page otherwise.
    "not_found_handling": "404-page",
    // Redirect /index.html and trailing-slash variants to clean URLs.
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "tugql.org", "custom_domain": true },
    { "pattern": "www.tugql.org", "custom_domain": true },
    { "pattern": "dtql.org", "custom_domain": true },
    { "pattern": "www.dtql.org", "custom_domain": true }
  ]
}
